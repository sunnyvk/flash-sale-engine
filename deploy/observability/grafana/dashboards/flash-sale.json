          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"booking-service\",method=\"POST\",uri=\"/api/v1/bookings\"}[1m])))",
          "legendFormat": "p50",
          "refId": "A",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"booking-service\",method=\"POST\",uri=\"/api/v1/bookings\"}[1m])))",
          "legendFormat": "p95",
          "refId": "B",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
