          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"booking-service\",method=\"POST\",uri=\"/api/v1/bookings\"}[1m])))",
          "legendFormat": "p99",
          "refId": "C",
          "editorMode": "code"
