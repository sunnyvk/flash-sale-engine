# Copy to .env (`make init`) and change every value marked CHANGE_ME. .env is git-ignored; this file is not.
# These are LOCAL DEV placeholders. Production values come from the secret store / GitHub Actions secrets (phases 8-9).

# --- MySQL (docker-compose creates one database + one user per service) ---
MYSQL_ROOT_PASSWORD=CHANGE_ME_root
BOOKING_DB_USER=booking
BOOKING_DB_PASSWORD=CHANGE_ME_booking
PAYMENT_DB_USER=payment
PAYMENT_DB_PASSWORD=CHANGE_ME_payment
NOTIFICATION_DB_USER=notification
NOTIFICATION_DB_PASSWORD=CHANGE_ME_notification

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis

# --- Kafka (used from phase 4; host-side listener) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# --- Auth (phase 6) ---
# JWT_SECRET signs every access token: at least 32 characters, never reuse it, never commit it.
# Generate one:  openssl rand -base64 48        (no openssl on Windows? any 40+ random characters will do)
JWT_SECRET=CHANGE_ME_at_least_32_random_characters
# The first ADMIN account, created at startup if BOTH are set (the API cannot create admins). Leave empty to skip.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_admin_password

# --- Behaviour ---
# 'never' in production
HEALTH_DETAILS=always
LOG_LEVEL=INFO

# Login brute-force guard and refresh tokens (optional, these are the defaults)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW=PT15M
REFRESH_TOKEN_TTL=P7D
# Set to 'native' only when the service runs behind a trusted proxy (nginx / ALB), so the limiter sees the real client IP
FORWARD_HEADERS_STRATEGY=none
